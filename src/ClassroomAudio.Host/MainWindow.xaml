<Window x:Class="ClassroomAudio.Host.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ClasseAudio — serveur local"
        Width="1120" Height="820" MinWidth="900" MinHeight="700"
        WindowStartupLocation="CenterScreen"
        Background="#F3F6F8"
        FontFamily="Segoe UI">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#16263A" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#607286" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,3" />
        </Style>
        <Style x:Key="ValueText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="16,9" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="175" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,18">
            <StackPanel>
                <TextBlock Text="ClasseAudio" FontSize="28" FontWeight="Bold" />
                <TextBlock Text="Relais audio local de la salle — le PC héberge le cours, sans service Cloud." FontSize="13" Foreground="#607286" />
            </StackPanel>
            <Border HorizontalAlignment="Right" VerticalAlignment="Center" Padding="12,7" CornerRadius="16" Background="#E8EEF1">
                <TextBlock x:Name="StatusText" Text="Arrêté" FontWeight="SemiBold" Foreground="#526477" />
            </Border>
        </Grid>

        <Border Grid.Row="1" Background="White" CornerRadius="12" Padding="18" Margin="0,0,0,14" BorderBrush="#E3E9ED" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Session de classe" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock x:Name="SummaryText" Text="Démarrez le serveur avant le cours. Les codes sont générés localement pour chaque session." Foreground="#607286" Margin="0,4,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="StartButton" Content="Démarrer le cours" Click="StartButton_Click" Background="#176B5B" Foreground="White" BorderThickness="0" />
                    <Button x:Name="StopButton" Content="Arrêter" Click="StopButton_Click" IsEnabled="False" Background="#F1F3F5" Foreground="#16263A" BorderBrush="#D5DEE4" />
                    <Button x:Name="CopyButton" Content="Copier les infos" Click="CopyButton_Click" IsEnabled="False" Background="#F1F3F5" Foreground="#16263A" BorderBrush="#D5DEE4" Margin="0" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="2" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.05*" />
                <ColumnDefinition Width="1.3*" />
                <ColumnDefinition Width="1.1*" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="White" CornerRadius="12" Padding="16" Margin="0,0,10,0" BorderBrush="#E3E9ED" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Accès professeur" Style="{StaticResource CardTitle}" />
                    <TextBlock Text="CODE DE CLASSE" Style="{StaticResource FieldLabel}" />
                    <TextBlock x:Name="JoinCodeText" Text="— — — — — —" FontSize="24" FontWeight="Bold" Foreground="#176B5B" />
                    <TextBlock Text="PIN professeur" Style="{StaticResource FieldLabel}" Margin="0,12,0,3" />
                    <TextBlock x:Name="TeacherPinText" Text="— — — — — —" FontSize="20" FontWeight="SemiBold" />
                </StackPanel>
            </Border>
            <Border Grid.Column="1" Background="White" CornerRadius="12" Padding="16" Margin="0,0,10,0" BorderBrush="#E3E9ED" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Réseau local" Style="{StaticResource CardTitle}" />
                    <TextBlock Text="ADRESSE MANUELLE DE SECOURS" Style="{StaticResource FieldLabel}" />
                    <TextBlock x:Name="ServerAddressText" Text="—" FontFamily="Consolas" FontSize="13" />
                    <TextBlock Text="Découverte automatique" Style="{StaticResource FieldLabel}" Margin="0,12,0,3" />
                    <TextBlock x:Name="MdnsText" Text="_classeaudio._tcp.local" FontFamily="Consolas" FontSize="12" />
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Background="White" CornerRadius="12" Padding="16" BorderBrush="#E3E9ED" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="État audio" Style="{StaticResource CardTitle}" />
                    <TextBlock Text="TÉLÉPHONES CONNECTÉS" Style="{StaticResource FieldLabel}" />
                    <TextBlock x:Name="ParticipantsText" Text="0" FontSize="25" FontWeight="Bold" />
                    <TextBlock Text="Élève autorisé à parler" Style="{StaticResource FieldLabel}" Margin="0,10,0,3" />
                    <TextBlock x:Name="ActiveSpeakerText" Text="Aucun" FontSize="13" />
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="3" Background="White" CornerRadius="12" Padding="14" Margin="0,0,0,14" BorderBrush="#E3E9ED" BorderThickness="1">
            <DockPanel>
                <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="Participants" FontSize="15" FontWeight="SemiBold" />
                        <TextBlock Text="État de connexion et droits de publication reçus du serveur." FontSize="12" Foreground="#607286" />
                    </StackPanel>
                    <TextBlock x:Name="NoRecordingText" Text="● Aucun enregistrement audio" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="#176B5B" FontSize="12" FontWeight="SemiBold" />
                </Grid>
                <DataGrid x:Name="ParticipantGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal" Background="White" BorderThickness="0"
                          RowBackground="White" AlternatingRowBackground="#F8FAFB" FontSize="12">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Nom affiché" Binding="{Binding DisplayName}" Width="2*" />
                        <DataGridTextColumn Header="Rôle" Binding="{Binding Role}" Width="*" />
                        <DataGridTextColumn Header="Connexion" Binding="{Binding State}" Width="*" />
                        <DataGridTextColumn Header="Publication micro" Binding="{Binding CanPublish}" Width="1.3*" />
                        <DataGridTextColumn Header="Pistes" Binding="{Binding PublishedTrackCount}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>

        <Border Grid.Row="4" Background="#132236" CornerRadius="12" Padding="14" BorderBrush="#132236" BorderThickness="1">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Journal technique" Foreground="White" FontWeight="SemiBold" Margin="0,0,0,8" />
                <ListBox x:Name="LogList" Background="#132236" Foreground="#D7E3EA" BorderThickness="0"
                         FontFamily="Consolas" FontSize="11" ScrollViewer.VerticalScrollBarVisibility="Auto" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
