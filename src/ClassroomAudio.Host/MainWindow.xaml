<Window x:Class="ClassroomAudio.Host.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ClasseAudio — Salle de classe"
        Icon="Assets/classeaudio-icon.ico"
        Width="1240" Height="900" MinWidth="980" MinHeight="740"
        WindowStartupLocation="CenterScreen"
        Background="#F4F7FA"
        FontFamily="Segoe UI">
    <Window.Resources>
        <SolidColorBrush x:Key="Ink" Color="#173247" />
        <SolidColorBrush x:Key="Muted" Color="#627789" />
        <SolidColorBrush x:Key="Brand" Color="#0F766E" />
        <SolidColorBrush x:Key="Line" Color="#E1E9EE" />

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Muted}" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,5" />
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource Line}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="18" />
            <Setter Property="Padding" Value="18" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#163247" BlurRadius="20" ShadowDepth="3" Opacity="0.06" />
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="BaseButton" TargetType="Button">
            <Setter Property="Padding" Value="16,10" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="11">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.88" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.76" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
            <Setter Property="Background" Value="#0F766E" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style x:Key="LightButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
            <Setter Property="Background" Value="#F0F6F7" />
            <Setter Property="Foreground" Value="#173247" />
            <Setter Property="BorderBrush" Value="#DCE6EC" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
    </Window.Resources>

    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="160" />
        </Grid.RowDefinitions>

        <!-- Brand header -->
        <Grid Grid.Row="0" Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="58" Height="58" CornerRadius="17" Background="#0F766E" Margin="0,0,14,0">
                    <Viewbox Margin="7">
                        <Canvas Width="48" Height="48">
                            <Path Fill="White" Data="M8,18 H16.6 L32.5,10.9 C33.8,10.3 35.3,11.3 35.3,12.7 V35.3 C35.3,36.7 33.8,37.7 32.5,37.1 L16.6,30 H8 C5.8,30 4,28.2 4,26 V22 C4,19.8 5.8,18 8,18 Z" />
                            <Path Fill="White" Data="M12.5,30.5 H18.1 L22,42 H16 Z" />
                            <Path Stroke="#FFD28A" StrokeThickness="2.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M38.5,18.5 C40.8,20.7 42,23.4 42,26.5 C42,29.6 40.8,32.3 38.5,34.5" />
                            <Path Stroke="#FFD28A" StrokeThickness="2.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M42.3,14.5 C45.5,17.6 47,21.3 47,26.5 C47,31.7 45.5,35.4 42.3,38.5" />
                        </Canvas>
                    </Viewbox>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="ClasseAudio" FontSize="25" FontWeight="Bold" />
                    <TextBlock Text="LE SON DE LA CLASSE, EN LOCAL" FontSize="10" FontWeight="SemiBold" Foreground="#627789" />
                </StackPanel>
            </StackPanel>
            <Border Grid.Column="1" Background="#E6F4F1" CornerRadius="18" Padding="13,8" VerticalAlignment="Center">
                <TextBlock x:Name="StatusText" Text="Arrêté" Foreground="#627789" FontWeight="SemiBold" FontSize="11" />
            </Border>
        </Grid>

        <!-- Session controls -->
        <Border Grid.Row="1" Background="#123044" CornerRadius="20" Padding="22" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Margin="0,0,24,0">
                    <TextBlock Text="VOTRE SALLE, EN QUELQUES SECONDES" FontSize="10" FontWeight="Bold" Foreground="#A9E4D8" />
                    <TextBlock Text="La voix du professeur, au cœur de la classe." FontSize="22" FontWeight="Bold" Foreground="White" Margin="0,5,0,4" />
                    <TextBlock x:Name="SummaryText" Text="Démarrez le relais local. Les élèves auront besoin uniquement du code de classe." FontSize="13" Foreground="#D0DEE8" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="StartButton" Content="Démarrer le cours" Click="StartButton_Click" Style="{StaticResource PrimaryButton}" Background="#16A394" Foreground="White" />
                    <Button x:Name="StopButton" Content="Arrêter" Click="StopButton_Click" IsEnabled="False" Style="{StaticResource LightButton}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Room code, discovery, and audio overview -->
        <Grid Grid.Row="2" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.05*" />
                <ColumnDefinition Width="1.3*" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="À communiquer aux élèves" Style="{StaticResource CardTitle}" />
                    <TextBlock Text="CODE DE CLASSE" Style="{StaticResource FieldLabel}" />
                    <TextBlock x:Name="JoinCodeText" Text="— — — — — —" FontSize="29" FontWeight="Bold" Foreground="#0F766E" />
                    <Button x:Name="CopyButton" Content="Copier le code" Click="CopyButton_Click" IsEnabled="False" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Margin="0,8,0,12" />
                    <Border Height="1" Background="#E7EDF1" Margin="0,0,0,10" />
                    <TextBlock Text="PIN PROFESSEUR · À GARDER PRIVÉ" Style="{StaticResource FieldLabel}" />
                    <TextBlock x:Name="TeacherPinText" Text="— — — — — —" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock Text="Le bouton copie seulement le code élève." FontSize="11" Foreground="#718596" Margin="0,5,0,0" />
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource Card}" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="Détection automatique" Style="{StaticResource CardTitle}" />
                    <TextBlock Text="Les téléphones cherchent le PC sur le réseau local. L'adresse technique n'est pas à partager." FontSize="13" Foreground="#627789" Margin="0,0,0,10" />
                    <Border Background="#EFF7F6" CornerRadius="12" Padding="11,9" Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="9" Height="9" Fill="#0F766E" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock x:Name="MdnsText" Text="mDNS + recherche locale · en attente du relais" FontSize="12" FontWeight="SemiBold" Foreground="#17685F" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <Expander Header="Détails réseau · dépannage" Foreground="#0F766E" FontSize="12" FontWeight="SemiBold" IsExpanded="False">
                        <StackPanel Margin="4,8,0,0">
                            <TextBlock Text="Adresse de secours (ne pas partager aux élèves)" Style="{StaticResource FieldLabel}" />
                            <TextBlock x:Name="ServerAddressText" Text="—" FontFamily="Consolas" FontSize="12" Foreground="#496476" />
                            <TextBlock Text="En cas d'échec, vérifier que le PC et le téléphone sont sur le même Wi-Fi privé et que le pare-feu autorise ClasseAudio." FontSize="11" Foreground="#718596" Margin="0,8,0,0" />
                        </StackPanel>
                    </Expander>
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="La salle en direct" Style="{StaticResource CardTitle}" />
                    <TextBlock Text="TÉLÉPHONES CONNECTÉS" Style="{StaticResource FieldLabel}" />
                    <TextBlock x:Name="ParticipantsText" Text="0" FontSize="34" FontWeight="Bold" Foreground="#123044" />
                    <Border Height="1" Background="#E7EDF1" Margin="0,8,0,10" />
                    <TextBlock Text="ORATEUR ÉLÈVE" Style="{StaticResource FieldLabel}" />
                    <TextBlock x:Name="ActiveSpeakerText" Text="Aucun" FontSize="13" FontWeight="SemiBold" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Participant list -->
        <Border Grid.Row="3" Style="{StaticResource Card}" Padding="16" Margin="0,0,0,16">
            <DockPanel>
                <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Participants" FontSize="17" FontWeight="SemiBold" />
                        <TextBlock Text="Connexion et droits de publication reçus du relais local." FontSize="12" Foreground="#718596" />
                    </StackPanel>
                    <TextBlock x:Name="NoRecordingText" Text="● Aucun enregistrement audio" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="#176B5B" FontSize="12" FontWeight="SemiBold" />
                </Grid>
                <DataGrid x:Name="ParticipantGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal" Background="White" BorderThickness="0"
                          RowBackground="White" AlternatingRowBackground="#F7FAFB" FontSize="12"
                          CanUserResizeRows="False" SelectionMode="Single" SelectionUnit="FullRow">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Nom affiché" Binding="{Binding DisplayName}" Width="2*" />
                        <DataGridTextColumn Header="Rôle" Binding="{Binding Role}" Width="*" />
                        <DataGridTextColumn Header="Connexion" Binding="{Binding State}" Width="*" />
                        <DataGridTextColumn Header="Micro autorisé" Binding="{Binding CanPublish}" Width="1.3*" />
                        <DataGridTextColumn Header="Pistes" Binding="{Binding PublishedTrackCount}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>

        <!-- Diagnostics -->
        <Border Grid.Row="4" Background="#142C3D" CornerRadius="16" Padding="16" BorderBrush="#142C3D" BorderThickness="1">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Journal technique" Foreground="White" FontWeight="SemiBold" Margin="0,0,0,8" />
                <ListBox x:Name="LogList" Background="#142C3D" Foreground="#D7E3EA" BorderThickness="0"
                         FontFamily="Consolas" FontSize="11" ScrollViewer.VerticalScrollBarVisibility="Auto" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
