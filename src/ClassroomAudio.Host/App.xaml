<Application x:Class="ClassroomAudio.Host.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="InkBrush" Color="#173247" />
        <SolidColorBrush x:Key="MutedBrush" Color="#627789" />
        <SolidColorBrush x:Key="AccentBrush" Color="#0F766E" />
        <SolidColorBrush x:Key="PageBrush" Color="#F4F7FA" />
        <SolidColorBrush x:Key="CardBrush" Color="#FFFFFF" />
    </Application.Resources>
</Application>
